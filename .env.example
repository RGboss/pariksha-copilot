# ==============================================================
# Pariksha Copilot Environment Configuration
# ==============================================================

# 1. Google Gemini API Key (Required for AI Tutor, Strategy, and Vector RAG)
# Get yours from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database Configuration
# - For Docker SQLite: sqlite:////app/data/gov_exam_portal.db (default)
# - For Docker PostgreSQL: postgresql+psycopg2://pariksha_user:pariksha_secret_pass@db:5432/pariksha_copilot
# - Leave blank or unset to default to SQLite (data/gov_exam_portal.db)
DATABASE_URL=

# 3. Persistent Storage Directories (defaults in Docker)
CHROMA_PERSIST_DIR=/app/data/chroma_db
UPLOAD_DIR=/app/data/uploads

# 4. Docker Compose PostgreSQL Settings (Optional overrides)
POSTGRES_USER=pariksha_user
POSTGRES_PASSWORD=pariksha_secret_pass
POSTGRES_DB=pariksha_copilot

# 5. Web Server Port Configuration
# When running with Docker Compose, Nginx binds to this host port (default 8082)
PORT=8082
