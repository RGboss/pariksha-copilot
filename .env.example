# ==============================================================
# Pariksha Copilot Environment Configuration
# ==============================================================

# 1. Google Gemini API Key (Required for AI Tutor, Strategy, and Vector RAG)
# Get yours from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database Configuration
# - For Docker: automatically configured in docker-compose.yml with PostgreSQL
# - For Local PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/pariksha_copilot
# - Leave blank or unset to default to local SQLite (data/gov_exam_portal.db)
DATABASE_URL=

# 3. Docker Compose PostgreSQL Settings (Optional overrides)
POSTGRES_USER=pariksha_user
POSTGRES_PASSWORD=pariksha_secret_pass
POSTGRES_DB=pariksha_copilot

# 4. Web Server Port Configuration
# When running with Docker Compose, Nginx binds to this host port (default 80)
PORT=80
